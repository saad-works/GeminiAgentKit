<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>GeminiAgentKit.Client</PackageId>
    <Version>1.0.0</Version>
    <Authors>Saad</Authors>
    <Description>C# client for building agentic applications on Google's Gemini API. Handles tool registration, schema generation, and the function-calling loop automatically.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/saad-works/GeminiAgentKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/saad-works/GeminiAgentKit</RepositoryUrl>
    <PackageTags>gemini;google;ai;agents;function-calling;llm;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeminiAgentKit.Types\GeminiAgentKit.Types.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
